# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Instagram login (use a throwaway/secondary account, NOT your main one)
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# Optional: your Telegram user id, only this user can use the bot (leave blank to allow everyone)
ALLOWED_USER_ID=
